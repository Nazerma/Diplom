# Required to run the Telegram bot
TELEGRAM_TOKEN=

# Optional: enables Gemini-generated replies. The bot falls back to local
# ranked results when this value is absent or the API is unavailable.
GEMINI_API_KEY=

# Optional application configuration
SHOP_NAME=Nazerva
DB_PATH=shop.db
ADMIN_IDS=

# Optional: a Telegram chat ID that receives manual order notifications.
# Leave empty for demo mode; no customer data will be forwarded.
ORDERS_CHAT_ID=

# Optional text shown after a manual order is created.
PAYMENT_DETAILS=Payment details are configured by the shop administrator.
